# xl_4x4_10ep: FLAN-T5-xl, 4 x 4 on 1 GPU = 16 examples per update, 10 epochs.
# Trained before the configs/ layout; OUTPUT_DIR keeps its original folder.
MODEL_NAME=google/flan-t5-xl
TRAIN_BATCH_SIZE=4
GRAD_ACCUMULATION_STEPS=4
NUM_EPOCHS=10
GRADIENT_CHECKPOINTING=1
GENERATION_BATCH_SIZE=8
OUTPUT_DIR=outputs/flan-t5-xl_nmr_input1536_4x4_ep10
