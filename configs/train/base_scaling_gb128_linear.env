# Batch-scaling validation, linear arm: FLAN-T5-base, global batch 128 on
# 2 nodes (16 per GPU x 8 GPUs), learning rate scaled by linear(128 / 16)
# with 3% warmup. Compare with base_scaling_gb16 on the first 20,000 test
# molecules (see the README).
MODEL_NAME=google/flan-t5-base
PER_GPU_BATCH=16
GRAD_ACCUMULATION_STEPS=1
NUM_EPOCHS=3
PARALLEL_MODE=ddp
NODES=2
GPUS_PER_NODE=4
LR_SCALING=linear
WARMUP_RATIO=0.03
