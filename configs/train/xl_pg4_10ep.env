# xl_pg4_10ep: FLAN-T5-XL, 4 examples per GPU, 10 epochs, on any number of
# nodes: ./submit.sh train xl_pg4_10ep --nodes 4   (16 GPUs, global batch 64)
# The global batch grows with the GPUs, so the learning rate is scaled from
# the batch-16 recipe. Use the LR_SCALING and WARMUP_RATIO that the
# base_scaling_* experiments validated.
MODEL_NAME=google/flan-t5-xl
PER_GPU_BATCH=4
GRAD_ACCUMULATION_STEPS=1
NUM_EPOCHS=10
GRADIENT_CHECKPOINTING=0
PARALLEL_MODE=ddp
GPUS_PER_NODE=4
LR_SCALING=sqrt
WARMUP_RATIO=0.03
