# xxl_pg2_10ep: FLAN-T5-XXL, 2 examples per GPU, 10 epochs, on 2 or more
# nodes: ./submit.sh train xxl_pg2_10ep --nodes 4   (16 GPUs, global batch 32)
# hsdp shards the model over the 4 GPUs of each node and replicates it across
# nodes. Use the LR_SCALING and WARMUP_RATIO that the base_scaling_*
# experiments validated.
MODEL_NAME=google/flan-t5-xxl
PER_GPU_BATCH=2
GRAD_ACCUMULATION_STEPS=1
NUM_EPOCHS=10
GRADIENT_CHECKPOINTING=1
PARALLEL_MODE=hsdp
NODES=2
GPUS_PER_NODE=4
LR_SCALING=sqrt
WARMUP_RATIO=0.03
