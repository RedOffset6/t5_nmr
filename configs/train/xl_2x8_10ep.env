# xl_2x8_10ep: FLAN-T5-xl, 2 x 8 on 1 GPU = 16 examples per update, 10 epochs.
# Trained before the configs/ layout; OUTPUT_DIR keeps its original folder.
MODEL_NAME=google/flan-t5-xl
TRAIN_BATCH_SIZE=2
GRAD_ACCUMULATION_STEPS=8
NUM_EPOCHS=10
GRADIENT_CHECKPOINTING=1
GENERATION_BATCH_SIZE=8
OUTPUT_DIR=outputs/flan-t5-xl_nmr_input1536_2x8_ep10
