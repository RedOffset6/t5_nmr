# large_4x4_3ep: FLAN-T5-large, 4 x 4 on 1 GPU = 16 examples per update, 3 epochs.
# Trained before the configs/ layout; OUTPUT_DIR keeps its original folder.
MODEL_NAME=google/flan-t5-large
TRAIN_BATCH_SIZE=4
GRAD_ACCUMULATION_STEPS=4
NUM_EPOCHS=3
GRADIENT_CHECKPOINTING=0
GENERATION_BATCH_SIZE=8
OUTPUT_DIR=outputs/flan-t5-large_nmr_input1536_bs16
