# base_16x1_3ep: FLAN-T5-base, 16 x 1 on 1 GPU = 16 examples per update, 3 epochs.
# Trained before the configs/ layout; OUTPUT_DIR keeps its original folder.
MODEL_NAME=google/flan-t5-base
TRAIN_BATCH_SIZE=16
GRAD_ACCUMULATION_STEPS=1
NUM_EPOCHS=3
GRADIENT_CHECKPOINTING=1
OUTPUT_DIR=outputs/flan-t5-base_nmr_input1536_16x1_3ep
