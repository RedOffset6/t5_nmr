# Memory probe (audit A4): does FLAN-T5-XL at batch 4 fit on one GPU without
# gradient checkpointing? Look for "Peak GPU memory allocated" in the log.
# If it fits, GRADIENT_CHECKPOINTING=0 makes the single-GPU XL runs faster.
MODEL_NAME=google/flan-t5-xl
TRAIN_BATCH_SIZE=4
GRAD_ACCUMULATION_STEPS=4
NUM_EPOCHS=1
GRADIENT_CHECKPOINTING=0
MAX_STEPS=200
TEST_SAMPLE_SIZE=100
TRAIN_TIME=01:00:00
